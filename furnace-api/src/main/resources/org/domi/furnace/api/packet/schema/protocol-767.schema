# ---------------------------------------------------------------- 핸드셰이크
state handshake
packet serverbound intention ClientIntentionPacket record
  int protocolVersion
  String hostName
  int port u16
  ClientIntent intention

# ---------------------------------------------------------------- 상태
state status
packet clientbound status_response ClientboundStatusResponsePacket record
  ServerStatus status
packet serverbound status_request ServerboundStatusRequestPacket singleton

# ---------------------------------------------------------------- 핑·쿠키 (여러 상태에서 같이 쓰임)
